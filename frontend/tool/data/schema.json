{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Nexauren Tool Registry",
  "type":"object",
  "required":["version","site","basePath","categories","tools"],
  "properties":{
    "version":{"type":"integer","minimum":1},
    "site":{"type":"string","minLength":1},
    "basePath":{"type":"string"},
    "categories":{"type":"array","items":{
      "type":"object","required":["id","name","description","path"],
      "properties":{"id":{"type":"string","pattern":"^[a-z0-9-]+$"},"name":{"type":"string"},"description":{"type":"string"},"icon":{"type":"string"},"sortOrder":{"type":"integer"},"path":{"type":"string"}},
      "additionalProperties":true
    }},
    "tools":{"type":"array","items":{
      "type":"object","required":["id","name","category","description","path","version","status"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z0-9-]+$"},
        "name":{"type":"string","minLength":1},
        "category":{"type":"string"},
        "description":{"type":"string"},
        "path":{"type":"string"},
        "version":{"type":"string"},
        "status":{"enum":["active","disabled","draft"]},
        "access":{"enum":["public","account","premium"]},
        "icon":{"type":"string"},
        "tags":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":true
    }}
  },
  "additionalProperties":false
}