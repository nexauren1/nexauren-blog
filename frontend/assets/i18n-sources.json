      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "privacyP1",
      "source_text": "A Nexauren Story respeita a privacidade de quem utiliza os seus sites, contas e ferramentas."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "privacyP2",
      "source_text": "Podem ser tratados nome, email, fotografia de perfil, preferências e dados necessários ao funcionamento e segurança da conta."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "privacyP3",
      "source_text": "Os dados são utilizados para autenticação, funcionamento, personalização, segurança, suporte e melhoria dos serviços."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "privacyP4",
      "source_text": "Algumas funcionalidades dependem de fornecedores técnicos. O objetivo é limitar os dados partilhados ao necessário."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "privacyP5",
      "source_text": "Pode solicitar informações, correção ou eliminação dos seus dados quando aplicável."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "privacyP6",
      "source_text": "Esta política pode ser atualizada. A data indicada acima identifica a versão atual."
