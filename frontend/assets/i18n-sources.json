    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "privacyP1",
      "source_text": "A Nexauren Story respeita a privacidade de quem utiliza os seus sites, contas e ferramentas."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "privacyP2",
      "source_text": "Podem ser tratados nome, email, fotografia de perfil, preferências e dados necessários ao funcionamento e segurança da conta."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "privacyP3",
      "source_text": "Os dados são utilizados para autenticação, funcionamento, personalização, segurança, suporte e melhoria dos serviços."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "privacyP4",
      "source_text": "Algumas funcionalidades dependem de fornecedores técnicos. O objetivo é limitar os dados partilhados ao necessário."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "privacyP5",
      "source_text": "Pode solicitar informações, correção ou eliminação dos seus dados quando aplicável."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "privacyP6",
      "source_text": "Esta política pode ser atualizada. A data indicada acima identifica a versão atual."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "termsP1",
      "source_text": "Ao utilizar a Nexauren Story, concorda em utilizar os serviços de forma legal, responsável e respeitosa."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "termsP2",
      "source_text": "As ferramentas são disponibilizadas para fins gerais e podem ser melhoradas, alteradas ou descontinuadas. Verifique resultados antes de os utilizar em decisões importantes."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "termsP3",
      "source_text": "É responsável por manter os dados da sua conta corretos e por proteger o acesso à mesma."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "termsP4",
      "source_text": "Não utilize os serviços para fraude, abuso, tentativa de comprometer sistemas ou violação de direitos."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "termsP5",
      "source_text": "Podem ocorrer interrupções para manutenção, segurança ou outras razões técnicas."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "termsP6",
      "source_text": "Os termos podem ser atualizados para refletir mudanças nos serviços ou requisitos legais."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "cookiesP1",
      "source_text": "Cookies e tecnologias semelhantes podem manter sessões, guardar preferências e medir o funcionamento das páginas."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "cookiesP2",
      "source_text": "Alguns são necessários para autenticação e segurança."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "cookiesP3",
      "source_text": "Algumas páginas públicas podem utilizar ferramentas de medição para compreender visitas e melhorar a experiência."
    },
    {
      "scope": "ui",
      "entity_id": "legal",
      "translation_key": "cookiesP4",
      "source_text": "Pode controlar ou eliminar cookies através das definições do seu navegador. Desativar cookies essenciais pode impedir algumas funcionalidades."
    }
