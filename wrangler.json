{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexauren-blog",
  "main": "worker-entry.js",
  "compatibility_date": "2026-09-17",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/__/auth/*",
      "/api/*",
      "/admin",
      "/account/*",
      "/blog/*",
      "/tool/*",
      "/post/*",
      "/sitemap.xml",
      "/sitemap-pages.xml",
      "/sitemap-posts.xml",
      "/robots.txt",
      "/rss.xml"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexauren-blog",
      "database_id": "61bc46d2-fe1f-41f7-a12a-883a1e5956b0"
    },
    {
      "binding": "ACCOUNTS_DB",
      "database_name": "nexauren",
      "database_id": "2f22bdb8-8e34-4036-bbd7-10053cfbca24"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
