{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexauren-blog",
  "main": "worker-entry.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexauren-db",
      "database_id": "fb3b3106-59a9-4b96-b28a-9559e0ed344d",
      "migrations_dir": "migrations/global"
    },
    {
      "binding": "BOOKS_DB",
      "database_name": "nexauren-blog",
      "database_id": "f249fa45-41ba-41e5-9e0a-9642afa6b1fd",
      "migrations_dir": "migrations/books"
    }
  ]
}
